    "test": "pnpm -r --if-present run test",
    "wrangler": "wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  }
}
