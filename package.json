{
  "name": "@arcahealth/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers monorepo for Arca Health",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
